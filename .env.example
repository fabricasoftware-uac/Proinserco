# ════════════════════════════════════════════════════════════════════
#  Variables de entorno de apps/web. TODAS documentadas, NINGÚN valor real.
#  Local: copiar a apps/web/.env.local (ignorado por Git).
#  Producción: variables del recurso en Coolify. Un secreto distinto por entorno.
#  Validación: apps/web/src/server/env.ts (servidor) y src/shared/env-publico.ts.
# ════════════════════════════════════════════════════════════════════

# ─── General ──────────────────────────────────────────────────────
# URL pública del sitio, sin barra final. https en producción (activa cookies
# __Host-, Secure y upgrade-insecure-requests). Construye la URL de retorno de pagos.
APP_URL="http://localhost:3000"

# Adaptadores: memoria = en memoria, con pasarela SIMULADA y usuarios demo (solo desarrollo
#                        local y E2E; en producción no hay pasarela ni usuarios)
#              real    = Supabase + Openpay Colombia
ADAPTADORES="memoria"
# En producción, memoria hace FALLAR el arranque salvo que se autorice aquí.
ADAPTADORES_MEMORIA_EN_PRODUCCION="no"
# Anti-bots: memoria | turnstile. Por defecto: turnstile con ADAPTADORES=real.
ANTIBOTS=""
# En producción la casilla de demostración (ANTIBOTS=memoria) y las claves de prueba de
# Cloudflare (1x0000…, 2x0000…, 3x0000…) hacen FALLAR el arranque. "si" solo para una demo pública.
ANTIBOTS_MEMORIA_EN_PRODUCCION="no"
# De dónde sale la IP del cliente: cloudflare (CF-Connecting-IP; SOLO si el origen
# rechaza lo que no venga de Cloudflare) | directo (X-Real-IP del proxy de Coolify)
# | vercel (serverless: X-Real-IP de Vercel; exige LIMITADOR_URL en producción).
# En Vercel la variable VERCEL (la define Vercel) también activa las reglas de serverless.
DESPLIEGUE="directo"

# ─── Sesión del panel ─────────────────────────────────────────────
# ≥ 32 caracteres aleatorios. Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESION_SECRETO=""

# ─── Donaciones ───────────────────────────────────────────────────
# Interruptor de emergencia (card testing, incidente): "no" desactiva crear cargos sin desplegar.
DONACIONES_HABILITADAS="si"
# Monto mínimo permitido en pesos (lo valida el servidor; montos ridículos = card testing).
DONACION_MONTO_MINIMO_COP="10000"
# Opcional. Tope máximo por donación en pesos; vacío = sin límite máximo.
DONACION_MONTO_MAXIMO_COP=""

# ─── CSP ──────────────────────────────────────────────────────────
# "si" = Content-Security-Policy-Report-Only (despliegue progresivo). Por defecto se aplica.
CSP_SOLO_REPORTE="no"

# ─── Supabase (SOLO servidor; el navegador nunca habla con Supabase) ─
SUPABASE_URL=""
# Clave anónima: aquí sin NEXT_PUBLIC_ porque no se usa en el navegador.
SUPABASE_ANON_KEY=""
# ⚠️ SE SALTA RLS POR COMPLETO. Solo tareas administrativas. NUNCA con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
# Pooler (6543) para la app; directa (5432) SOLO para migraciones.
DATABASE_URL=""
DATABASE_URL_DIRECT=""

# ─── Openpay Colombia (checkout hospedado) ────────────────────────
# Pasarela activa con ADAPTADORES=real: openpay | mercadopago.
PASARELA="openpay"
OPENPAY_MERCHANT_ID=""
# ⚠️ Llave PRIVADA. Solo servidor, nunca en logs, nunca con NEXT_PUBLIC_.
OPENPAY_PRIVATE_KEY=""
# https://sandbox-api.openpay.co (todo lo que no sea producción) | https://api.openpay.co (producción).
# env.ts impide mezclarlas salvo autorización explícita abajo.
OPENPAY_API_URL="https://sandbox-api.openpay.co"
# Solo activar "si" temporalmente en staging/pruebas sandbox con NODE_ENV=production (Coolify/VPS).
# Debe volver a "no" antes de usar llaves reales de producción.
OPENPAY_SANDBOX_EN_PRODUCCION="no"
# Basic auth que se configura en el dashboard de Openpay para el webhook.
# Sin estas dos (o sin OPENPAY_WEBHOOK_SECRETO_RUTA), /api/webhooks/openpay/[secreto] responde 404.
OPENPAY_WEBHOOK_USUARIO=""
OPENPAY_WEBHOOK_CONTRASENA=""
# Secreto en la ruta del webhook: /api/webhooks/openpay/<secreto> (≥ 32 caracteres aleatorios, URL-safe).
# Obligatoria con ADAPTADORES=real. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OPENPAY_WEBHOOK_SECRETO_RUTA=""
# Opcional: origen HTTPS adicional si Openpay usa otro subdominio en el checkout hospedado
# (se agrega a form-action de la CSP y a la lista blanca de urlPago). Ej.: "https://pagos.openpay.co"
OPENPAY_CHECKOUT_ORIGIN=""

# ─── Mercado Pago Colombia (Checkout Pro) ─────────────────────────
# Access Token privado de Mercado Pago (APP_USR-… o TEST-…). Solo servidor.
MERCADOPAGO_ACCESS_TOKEN=""
# Modo de checkout de Mercado Pago: produccion | sandbox.
MERCADOPAGO_MODO="produccion"
# Solo activar "si" temporalmente en pruebas sandbox con NODE_ENV=production.
MERCADOPAGO_SANDBOX_EN_PRODUCCION="no"
# Secreto en la ruta del webhook: /api/webhooks/mercadopago/<secreto> (≥ 32 caracteres aleatorios).
MERCADOPAGO_WEBHOOK_SECRETO_RUTA=""
# Clave secreta de firma HMAC-SHA256 (x-signature) obtenida en Tus integraciones → Webhooks.
MERCADOPAGO_WEBHOOK_FIRMA_SECRETO=""

# ─── Cron de conciliación diaria ──────────────────────────────────
# Secreto Bearer (≥ 32 caracteres aleatorios) para Authorization: Bearer <secreto>
# en POST /api/cron/conciliacion. Obligatoria con ADAPTADORES=real.
# En Vercel, Vercel Cron llama con GET y Bearer $CRON_SECRET: define CRON_SECRET con el MISMO valor.
CRON_CONCILIACION_SECRETO=""

# ─── Alertas operativas ───────────────────────────────────────────
# Opcional. Webhook entrante HTTPS (Slack, Discord, Google Chat, n8n, relay de correo…) al que
# la conciliación diaria envía las alertas (discrepancias, errores). Secreta: quien la tenga
# puede escribir en el canal. Sin valor, las alertas van solo al log y a la auditoría.
ALERTAS_WEBHOOK_URL=""

# ─── Correos transaccionales (Resend) ─────────────────────────────
# Clave secreta de Resend (re_…), solo servidor. Si se define junto con RESEND_DESDE,
# al aprobarse una donación se envía el comprobante al donante y el aviso interno.
RESEND_API_KEY=""
# Remitente verificado en Resend (p. ej. "Fundación Proinserco <donaciones@proinserco.org>").
RESEND_DESDE=""
# Correo interno opcional de la fundación para recibir aviso de donaciones aprobadas y certificados.
RESEND_CORREO_INTERNO=""

# ─── Cloudflare Turnstile ─────────────────────────────────────────
# Pública (va al navegador, se incrusta en el BUILD). 1x00000000000000000000AA = clave de pruebas.
# El build de PRODUCCIÓN (Dockerfile, CI, Vercel production) FALLA sin la clave real o con una de pruebas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# Secreta: solo servidor.
TURNSTILE_SECRET_KEY=""

# ─── Limitador de tasa compartido ─────────────────────────────────
# redis://… (red privada del VPS) o rediss://… (TLS, p. ej. Upstash). Vacío = memoria (válido
# SOLO con UNA instancia). OBLIGATORIA en serverless (Vercel): sin ella la app no arranca.
LIMITADOR_URL=""

# ─── Scripts (no los usa la app) ──────────────────────────────────
# Solo scripts/alta-usuario-panel.mjs: contraseña inicial del usuario que se da de alta
# (12 a 256 caracteres). Mejor NO definirla y escribirla en el prompt oculto; si se usa,
# solo en la sesión de terminal del alta y borrarla después. Nunca en la app ni en Coolify.
ALTA_USUARIO_CONTRASENA=""

# Solo para scripts/pexels.mjs. Ponerla en apps/web/.env.local, nunca aquí.
PEXELS_API_KEY=""

# ─── Tests de integración (solo locales o CI; jamás la base real) ─
# Postgres efímero con las migraciones aplicadas (CI: job integracion de .github/workflows/ci.yml;
# local: ver Handoff, sección 12). Sin valor, la suite RLS y los contratos Postgres se saltan.
TEST_DATABASE_URL=""
# Redis efímero para el contrato del limitador (p. ej. redis://127.0.0.1:6379). Sin valor, se salta.
TEST_REDIS_URL=""
